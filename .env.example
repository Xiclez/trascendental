# Copy to .env.local (dev) or .env (VPS / docker compose). Never commit real values.

# --- Sitio
# VPS: https://tu-dominio.mx (sin / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Igual que la anterior; se lee al arrancar (links de QR, correos, Stripe). Ponla siempre en producción.
SITE_URL=http://localhost:3000
# Solo docker compose: Caddy emite el certificado HTTPS para este dominio
DOMAIN=tu-dominio.mx

# --- Base de datos (Postgres)
# Dev: cualquier Postgres local. En docker compose se arma sola a partir de POSTGRES_PASSWORD.
DATABASE_URL=postgres://trascendental:cambia-esto@localhost:5432/trascendental
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga

# --- Stripe (https://dashboard.stripe.com/apikeys). sk_live_ en producción, sk_test_ para pruebas.
# Solo la secret key es necesaria: Checkout es un redirect y el sitio no carga Stripe.js.
STRIPE_SECRET_KEY=sk_live_xxx
# Opcional (sin uso hoy; es pública por diseño)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Webhook → https://tu-dominio.mx/api/stripe/webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
# Dev: stripe listen --forward-to localhost:3000/api/stripe/webhook (imprime el whsec_)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Admin (/admin)
ADMIN_PASSWORD=minimo-12-caracteres
ADMIN_SESSION_SECRET=genera-con-openssl-rand-hex-32

# --- Correo (EmailJS) para enviar los QR — https://dashboard.emailjs.com
# Plantilla: deploy/emailjs-template.html. Activar Account → Security →
# "Allow EmailJS API for non-browser applications". Límite: 1 envío/seg.
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID=template_xxx
EMAILJS_PUBLIC_KEY=xxx
EMAILJS_PRIVATE_KEY=xxx

# --- WhatsApp (Evolution API)
# POST {EVOLUTION_API_URL}/message/sendMedia/{EVOLUTION_INSTANCE}  header apikey
EVOLUTION_API_URL=https://evo.tu-dominio.mx
EVOLUTION_INSTANCE=trascendental
EVOLUTION_API_KEY=xxx
