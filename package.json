{
  "name": "trascendental-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:tee": "node scripts/prepare-tee.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait db",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait db",
    "db:psql": "docker compose -f docker-compose.dev.yml exec db psql -U trascendental -d trascendental",
    "stripe:listen": "node scripts/stripe-listen.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "postgres": "^4.0.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4",
    "@gltf-transform/functions": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "meshoptimizer": "^0.22",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
